# Database Configuration (Notebook 02 - Internal DB)
# Check RDS endpoint from CloudFormation Outputs and enter it here
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_NAME=agentdb
DB_USER=dbadmin
DB_PASSWORD=postgres

# Protein Design Configuration (Notebook 04 - Protein Design)
# Automatically retrieved from CloudFormation stack, no manual configuration needed
# STACK_NAME=protein-design-stack
# WORKFLOW_ID=auto-detected
# ROLE_ARN=auto-detected
# S3_BUCKET=auto-detected

# AWS Configuration
# Set AWS credentials using AWS CLI or environment variables
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_DEFAULT_REGION=us-east-1
